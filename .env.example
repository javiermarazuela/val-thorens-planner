# Supabase: Project Settings -> API. The anon / publishable key is safe in
# the browser; access is enforced by row level security. Never put the
# service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flight lookup (server only, never VITE_ prefixed). AeroDataBox on RapidAPI:
# rapidapi.com/aedbx-aedbx/api/aerodatabox -> subscribe (free Basic plan) ->
# copy the X-RapidAPI-Key. Set it in Vercel env vars too. Without it the form
# still works: people pick from the suggested flights or enter times by hand.
AERODATABOX_API_KEY=
# Optional: most API lookups allowed per calendar month (default 80).
AERODATABOX_MONTHLY_CAP=80
